# StageFlow staging environment template
# Copy to .env.staging and fill in secrets.
#
# Recommended bootstrap:
#   cp .env .env.staging
#   # Then update domain-specific values below.

# MinIO Object Storage
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-secure-32-char-password
MINIO_ACCESS_KEY=stageflow-app
MINIO_SECRET_KEY=your-secure-32-char-password

# Grafana Monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
GF_SERVER_ROOT_URL=https://staging.example.com/monitoring/

# AI Providers (optional)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_APP_TITLE="StageFlow (staging)"
OPENROUTER_APP_REFERER=https://staging.example.com
AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Public staging domain used by CORS/presigned URLs/frontend
STAGEFLOW_PUBLIC_DOMAIN=staging.example.com

# Force staging stack network isolation
STAGEFLOW_NETWORK_NAME=stageflow_staging_net

# Frontend Configuration
VITE_API_URL=https://staging.example.com
VITE_SITE_TITLE="StageFlow Staging"
VITE_SITE_URL=https://staging.example.com
VITE_GITHUB_URL=https://github.com/mattboback/stageflow
VITE_TAGLINE="Podman-native web accessibility scanning platform"
VITE_AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Explicit CORS for staging host
CORS_ALLOW_ORIGINS=https://staging.example.com
PLATFORM_API_CORS_ALLOW_ORIGINS=https://staging.example.com
