# Copy to `.env.staging` for a staging deployment.
# Keep real secrets (passwords/API keys) out of git.

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=stageflow
MINIO_SECRET_KEY=change-me

# Postgres
POSTGRES_USER=stageflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stageflow
DATABASE_URL=postgres://stageflow:change-me@postgres:5432/stageflow?sslmode=disable

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=https://your-domain.com/monitoring

# AI (optional)
OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=StageFlow (staging)
OPENROUTER_APP_REFERER=https://your-domain.com
AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Public stack config
STAGEFLOW_PUBLIC_DOMAIN=your-domain.com
STAGEFLOW_NETWORK_NAME=stageflow_net

# Frontend
VITE_API_URL=https://your-domain.com
VITE_SITE_TITLE=StageFlow
VITE_SITE_URL=https://your-domain.com
VITE_GITHUB_URL=https://github.com/mattboback/stageflow
VITE_TAGLINE=Podman-native web accessibility scanning platform
VITE_AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# CORS
PLATFORM_API_CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
