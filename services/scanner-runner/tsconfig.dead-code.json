// Used by `bun run analyze:dead` (ts-remove-unused / tsr) to find unused exports.
// Not used for compilation — noEmit ensures nothing is written to disk.
// See: https://github.com/line/ts-remove-unused
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "."
	},
	"include": ["src", "tests"]
}
