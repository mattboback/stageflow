{
	"extends": "../../tsconfig.strict.json",
	"compilerOptions": {
		"target": "ES2021",
		// node16 resolution replaces the legacy "node"/node10 algorithm, which is
		// deprecated in TypeScript 6 and removed in 7. package.json declares no
		// "type", so Node treats the emitted .js as CommonJS and `node16` emits
		// CommonJS to match — same output, modern resolution semantics.
		"module": "node16",
		"moduleResolution": "node16",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src"]
}
