{
	"name": "scanner-runner",
	"version": "0.1.0",
	"description": "StageFlow scanner execution runtime",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mattboback/stageflow.git",
		"directory": "services/scanner-runner"
	},
	"packageManager": "bun@1.3.8",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./lib": {
			"types": "./dist/lib.d.ts",
			"default": "./dist/lib.js"
		}
	},
	"scripts": {
		"prepare:contracts": "node scripts/prepare-contracts-report-types.mjs && node scripts/prepare-contracts-scanner-manifest.mjs",
		"build": "bun run prepare:contracts && tsc -p tsconfig.build.json && node scripts/copy-builtin-manifests.mjs",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"lint": "bun run prepare:contracts && eslint \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts eslint.config.mjs --cache --cache-location ../../.cache/eslint-scanner",
		"lint:strict": "bun run prepare:contracts && eslint \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts eslint.config.mjs --max-warnings 0 --cache --cache-location ../../.cache/eslint-scanner",
		"lint:fix": "bun run prepare:contracts && eslint \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts eslint.config.mjs --fix --cache --cache-location ../../.cache/eslint-scanner",
		"lint:staged": "bun run prepare:contracts && eslint --fix --cache --cache-location ../../.cache/eslint-scanner",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
		"type-check": "bun run prepare:contracts && tsc -p tsconfig.json --noEmit",
		"check:all": "bun run lint && bun run type-check && bun run test",
		"ci": "bun run format:check && bun run lint:strict && bun run type-check && bun run test:coverage",
		"knip": "knip",
		"find-dead-code": "knip --cache --cache-location ../../.cache/knip-scanner",
		"test": "bun run prepare:contracts && vitest run",
		"test:coverage": "bun run prepare:contracts && vitest run --coverage",
		"analyze:dead": "tsr --project tsconfig.json 'src/index\\.ts$' 'src/lib\\.ts$' 'src/scanners/[^/]+/index\\.ts$' 'tests/.*\\.(test|spec)\\.ts$'"
	},
	"dependencies": {
		"@axe-core/playwright": "^4.9.0",
		"@stageflow/contracts-scanner-manifest": "file:../../libs/contracts/scanner-manifest",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"chrome-launcher": "^1.2.1",
		"fast-glob": "^3.3.2",
		"fs-extra": "^11.2.0",
		"lighthouse": "^12.8.2",
		"minio": "^8.0.6",
		"nats": "^2.17.0",
		"playwright": "1.57.0",
		"playwright-core": "1.57.0",
		"sharp": "^0.34.5",
		"uuid": "13.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "24.10.1",
		"@vitest/coverage-v8": "4.0.13",
		"@vitest/eslint-plugin": "^1.3.20",
		"eslint": "^9.39.1",
		"eslint-plugin-perfectionist": "^5.2.0",
		"globals": "^17.5.0",
		"knip": "^5.79.0",
		"prettier": "^3.6.2",
		"ts-node": "^10.9.2",
		"tsr": "^1.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vitest": "4.0.13"
	},
	"overrides": {
		"esbuild": "0.27.0",
		"fast-xml-parser": "5.5.6",
		"flatted": "3.4.2",
		"lodash": "4.18.1",
		"lodash-es": "4.18.1",
		"picomatch": "2.3.2",
		"rollup": "4.59.0",
		"basic-ftp": "5.2.0"
	}
}
