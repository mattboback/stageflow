# Example staging host block (for staging/self-hosted environments only).
# Do NOT use this for the live stageflow.org production boundary.
# Add this to the Caddy instance that serves your public domains.
#
# Uses the staging compose overlay loopback ports:
#   frontend: 127.0.0.1:3300
#   platform: 127.0.0.1:8300
#   minio:    127.0.0.1:9300
#   grafana:  127.0.0.1:3301

staging.example.com {
    handle /api/* {
        reverse_proxy 127.0.0.1:8300
    }

    # Route signed MinIO artifact URLs through the public edge.
    # Buckets remain private; access requires the SigV4 query string generated by the Platform API.
    handle /scanner-artifacts/* {
        header {
            Access-Control-Allow-Origin "https://{http.request.host}"
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Range"
            Access-Control-Expose-Headers "Content-Length, Content-Range"
            Vary Origin
        }
        @options method OPTIONS
        respond @options 204
        reverse_proxy 127.0.0.1:9300 {
            header_up Host {http.request.host}
        }
    }

    handle /scanner-staging/* {
        header {
            Access-Control-Allow-Origin "https://{http.request.host}"
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Range"
            Access-Control-Expose-Headers "Content-Length, Content-Range"
            Vary Origin
        }
        @options method OPTIONS
        respond @options 204
        reverse_proxy 127.0.0.1:9300 {
            header_up Host {http.request.host}
        }
    }

    # Monitoring is disabled by default so this example cannot expose Grafana
    # accidentally. See infra/caddy/Caddyfile.monitoring.example for the
    # explicit opt-in proxy with Basic Auth.
    handle /monitoring* {
        respond 404
    }

    handle /* {
        reverse_proxy 127.0.0.1:3300
    }
}
