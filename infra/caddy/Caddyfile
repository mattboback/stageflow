# For staging/self-hosted environments only.
# Do NOT use this file as the live stageflow.org production boundary; it is a self-hosting/staging reference only.
# It assumes upstream services are already reachable on 127.0.0.1:3100 (frontend), 3101 (Grafana), 8100 (API), and 9100 (MinIO).
{
	# Set to your email for ACME registration (Let's Encrypt).
	# Example: email you@example.com
	email {$CADDY_EMAIL:you@example.com}
}

# Browser clients never receive PLATFORM_API_TOKEN. Only these exact public
# method/path pairs receive it at the edge; every other API request is proxied
# unchanged and must carry a caller-owned credential. Keep this snippet in
# sync with platform-api's public submission policies and router tests.
# Public pairs: anonymous/browser-auth URL POST, ZIP POST, scanners GET,
# job GET (status/stream/report/results), and job DELETE.
(stageflow_api) {
	@publicURLSubmission {
		method POST
		path /api/v1/jobs/urls/anonymous /api/v1/jobs/urls/browser-auth
	}
	handle @publicURLSubmission {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Api-Key "{$PLATFORM_API_TOKEN}"
			header_up -Authorization
		}
	}

	@publicZIPSubmission {
		method POST
		path /api/v1/jobs/zip
	}
	handle @publicZIPSubmission {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Api-Key "{$PLATFORM_API_TOKEN}"
			header_up -Authorization
		}
	}

	# Keep non-public methods and aliases in the URL/ZIP namespaces from being
	# mistaken for a bare job-status path by the public job-read matcher below.
	handle /api/v1/jobs/urls* {
		reverse_proxy 127.0.0.1:8100
	}
	handle /api/v1/jobs/zip* {
		reverse_proxy 127.0.0.1:8100
	}

	@publicScannerCatalog {
		method GET
		path /api/v1/scanners
	}
	handle @publicScannerCatalog {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Api-Key "{$PLATFORM_API_TOKEN}"
			header_up -Authorization
		}
	}

	@publicJobRead {
		method GET
		path_regexp public_job_read "^/api/v1/jobs/[A-Za-z0-9_-]{1,64}(?:/(?:stream|report|results))?$"
	}
	handle @publicJobRead {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Api-Key "{$PLATFORM_API_TOKEN}"
			header_up -Authorization
		}
	}

	@publicJobDelete {
		method DELETE
		path_regexp public_job_delete "^/api/v1/jobs/[A-Za-z0-9_-]{1,64}$"
	}
	handle @publicJobDelete {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Api-Key "{$PLATFORM_API_TOKEN}"
			header_up -Authorization
		}
	}

	# Protected fallback: project/baseline operations, diff reads,
	# caller-authenticated URL submissions, non-public methods, and all path
	# aliases reach platform-api without an injected credential.
	handle /api/* {
		reverse_proxy 127.0.0.1:8100
	}
}

# Public domain for this stack (override via STAGEFLOW_PUBLIC_DOMAIN).
{$STAGEFLOW_PUBLIC_DOMAIN:stageflow.org} {
	# Baseline security response headers for every route. Caddy terminates TLS
	# via ACME, so HSTS is safe to assert here. frame-ancestors blocks
	# clickjacking; nosniff blocks MIME-confusion; the referrer policy avoids
	# leaking full URLs cross-origin.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Don't advertise the server software.
		-Server
	}

	import stageflow_api

	# Route signed MinIO artifact URLs through the public edge.
	# Buckets remain private; access requires the SigV4 query string generated by the Platform API.
	# CORS headers required for fetch() redirects from API
	# Preserve Host header so presigned URLs remain valid
	handle /scanner-artifacts/* {
		header {
			# Match the served hostname (supports www/apex without extra config).
			Access-Control-Allow-Origin "https://{http.request.host}"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Range"
			Access-Control-Expose-Headers "Content-Length, Content-Range"
			Vary Origin
		}
		@options method OPTIONS
		respond @options 204
		reverse_proxy 127.0.0.1:9100 {
			# Preserve Host so MinIO can validate SigV4 presigned URLs.
			header_up Host {http.request.host}
		}
	}

	handle /scanner-staging/* {
		header {
			# Match the served hostname (supports www/apex without extra config).
			Access-Control-Allow-Origin "https://{http.request.host}"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Range"
			Access-Control-Expose-Headers "Content-Length, Content-Range"
			Vary Origin
		}
		@options method OPTIONS
		respond @options 204
		reverse_proxy 127.0.0.1:9100 {
			# Preserve Host so MinIO can validate SigV4 presigned URLs.
			header_up Host {http.request.host}
		}
	}

	# Monitoring is disabled by default so a fresh self-hosted Caddy config
	# cannot expose Grafana accidentally. See infra/caddy/Caddyfile.monitoring.example
	# for the explicit opt-in proxy with Basic Auth.
	handle /monitoring* {
		respond 404
	}

	# Proxy everything else to the frontend
	handle /* {
		reverse_proxy 127.0.0.1:3100
	}
}

# React frontend side-by-side subdomain
react.{$STAGEFLOW_PUBLIC_DOMAIN:stageflow.org} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Don't advertise the server software.
		-Server
	}

	import stageflow_api

	# Proxy everything else to the React frontend
	handle /* {
		reverse_proxy 127.0.0.1:3120
	}
}
