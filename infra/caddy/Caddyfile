# For staging/self-hosted environments only.
# Do NOT use this file as the live stageflow.org production boundary; it is a self-hosting/staging reference only.
# It assumes upstream services are already reachable on 127.0.0.1:3100 (frontend), 3101 (Grafana), 8100 (API), and 9100 (MinIO).
{
    # Set to your email for ACME registration (Let's Encrypt).
    # Example: email you@example.com
    email {$CADDY_EMAIL:you@example.com}
}

# Public domain for this stack (override via STAGEFLOW_PUBLIC_DOMAIN).
{$STAGEFLOW_PUBLIC_DOMAIN:stageflow.org} {
    # Baseline security response headers for every route. Caddy terminates TLS
    # via ACME, so HSTS is safe to assert here. frame-ancestors blocks
    # clickjacking; nosniff blocks MIME-confusion; the referrer policy avoids
    # leaking full URLs cross-origin.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
        X-Frame-Options "DENY"
        # Don't advertise the server software.
        -Server
    }

    # Proxy API requests directly to platform-api
    handle /api/* {
        reverse_proxy 127.0.0.1:8100
    }

    # Route signed MinIO artifact URLs through the public edge.
    # Buckets remain private; access requires the SigV4 query string generated by the Platform API.
    # CORS headers required for fetch() redirects from API
    # Preserve Host header so presigned URLs remain valid
    handle /scanner-artifacts/* {
        header {
            # Match the served hostname (supports www/apex without extra config).
            Access-Control-Allow-Origin "https://{http.request.host}"
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Range"
            Access-Control-Expose-Headers "Content-Length, Content-Range"
            Vary Origin
        }
        @options method OPTIONS
        respond @options 204
        reverse_proxy 127.0.0.1:9100 {
            # Preserve Host so MinIO can validate SigV4 presigned URLs.
            header_up Host {http.request.host}
        }
    }

    handle /scanner-staging/* {
        header {
            # Match the served hostname (supports www/apex without extra config).
            Access-Control-Allow-Origin "https://{http.request.host}"
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Range"
            Access-Control-Expose-Headers "Content-Length, Content-Range"
            Vary Origin
        }
        @options method OPTIONS
        respond @options 204
        reverse_proxy 127.0.0.1:9100 {
            # Preserve Host so MinIO can validate SigV4 presigned URLs.
            header_up Host {http.request.host}
        }
    }

    # Monitoring is disabled by default so a fresh self-hosted Caddy config
    # cannot expose Grafana accidentally. See infra/caddy/Caddyfile.monitoring.example
    # for the explicit opt-in proxy with Basic Auth.
    handle /monitoring* {
        respond 404
    }

    # Proxy everything else to the frontend
    handle /* {
        reverse_proxy 127.0.0.1:3100
    }
}

# React frontend side-by-side subdomain
react.{$STAGEFLOW_PUBLIC_DOMAIN:stageflow.org} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
        X-Frame-Options "DENY"
        # Don't advertise the server software.
        -Server
    }

    # Proxy API requests directly to platform-api
    handle /api/* {
        reverse_proxy 127.0.0.1:8100
    }

    # Proxy everything else to the React frontend
    handle /* {
        reverse_proxy 127.0.0.1:3120
    }
}

