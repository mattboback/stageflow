[Unit]
Description=StageFlow Pod
PartOf=stageflow.target
Wants=network-online.target
After=network-online.target

[Pod]
PodName=stageflow
Network=@NETWORK_NAME@
Network=ingress.network

# Network-scoped aliases for service discovery from job pods and other stacks
NetworkAlias=nats
NetworkAlias=minio
NetworkAlias=postgres
NetworkAlias=orchestrator
NetworkAlias=platform-api
NetworkAlias=frontend
NetworkAlias=grafana
NetworkAlias=stageflow-web
NetworkAlias=stageflow-api
NetworkAlias=stageflow-artifacts

[Install]
WantedBy=stageflow.target
