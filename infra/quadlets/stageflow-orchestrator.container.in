[Unit]
Description=StageFlow Orchestrator
PartOf=stageflow.target
Wants=network-online.target
After=network-online.target stageflow-nats.service stageflow-minio.service stageflow-postgres.service
Requires=stageflow-nats.service stageflow-minio.service stageflow-postgres.service

[Service]
EnvironmentFile=@APP_ENV_FILE@
Restart=always
RestartSec=2s
TimeoutStartSec=900
MemoryMax=1G

[Container]
Image=localhost/stageflow/orchestrator:@IMAGE_TAG@
User=0
Group=0
EnvironmentFile=@APP_ENV_FILE@
Pod=stageflow.pod
NoNewPrivileges=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
SecurityLabelDisable=true
Volume=%t/podman/podman.sock:/run/user/1000/podman/podman.sock:z
Environment=NATS_URL=nats://nats:4222
Environment=PODMAN_SOCKET=/run/user/1000/podman/podman.sock
Environment=MINIO_ENDPOINT=minio:9000
Environment=MINIO_USE_SSL=false
Environment=EXTRACTION_IMAGE=localhost/stageflow/extractor:@IMAGE_TAG@
Environment=SCANNER_IMAGE=localhost/stageflow/scanner-runner:@IMAGE_TAG@
Environment=API_PORT=8081
Environment=NATS_HOST=nats
Environment=MINIO_HOST=minio
Environment=POD_NETNS_MODE=bridge
Environment=POD_NETWORK=@NETWORK_NAME@
HealthCmd=/usr/local/bin/orchestrator-healthcheck
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=stageflow.target
