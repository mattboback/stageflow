[Unit]
Description=StageFlow React Frontend
PartOf=stageflow.target
Wants=network-online.target
After=network-online.target stageflow-platform-api.service
Requires=stageflow-platform-api.service

[Service]
Restart=always
RestartSec=2s
TimeoutStartSec=900
MemoryMax=128M

[Container]
Image=localhost/stageflow/frontend-react:@IMAGE_TAG@
Pod=stageflow.pod
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
Tmpfs=/var/cache/nginx:rw,noexec,nosuid,nodev,size=32m
Tmpfs=/var/run:rw,noexec,nosuid,nodev,size=8m
HealthCmd=/bin/sh -c 'wget -q --spider http://127.0.0.1:3020/ || exit 1'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=stageflow.target
