[Unit]
Description=StageFlow NATS (JetStream)
PartOf=stageflow.target
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=@APP_ENV_FILE@
Restart=always
RestartSec=2s
TimeoutStartSec=900
MemoryMax=256M

[Container]
Image=docker.io/library/nats:2.12.2-alpine
EnvironmentFile=@APP_ENV_FILE@
Pod=stageflow.pod
NoNewPrivileges=true
Volume=stageflow_nats_data:/data
Exec=-js -sd /data -m 8222
HealthCmd=/bin/sh -c 'wget -q --spider http://127.0.0.1:8222/healthz || exit 1'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=5s

[Install]
WantedBy=stageflow.target
