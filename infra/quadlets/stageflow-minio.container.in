[Unit]
Description=StageFlow MinIO
PartOf=stageflow.target
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=@ENV_FILE@
Restart=always
RestartSec=2s
TimeoutStartSec=900
MemoryMax=768M

[Container]
Image=docker.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
EnvironmentFile=@ENV_FILE@
Pod=stageflow.pod
NoNewPrivileges=true
Volume=stageflow_minio_data:/data
Exec=server /data --console-address :9001
HealthCmd=/bin/sh -c 'curl -f http://127.0.0.1:9000/minio/health/live || exit 1'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=stageflow.target
