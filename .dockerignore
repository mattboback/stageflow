.env
.env.*
*.local
.stageflow
infra/caddy/snippets/monitoring-basicauth*.caddy
infra/scanners/scanners.yaml
output

# Logs
*.log
logs

# CI/CD
.github

# OS files
.DS_Store
Thumbs.db
