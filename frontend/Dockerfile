# Multi-stage Dockerfile for SvelteKit Frontend
# Optimized for production with nginx

# Stage 1: Build
FROM oven/bun:1.3.0-alpine AS builder
WORKDIR /app

# Copy package files first for better caching
COPY portfolio/frontend/package.json portfolio/frontend/bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy SvelteKit source code
COPY portfolio/frontend/svelte.config.js portfolio/frontend/vite.config.ts portfolio/frontend/tsconfig.json ./
COPY portfolio/frontend/src ./src
COPY portfolio/frontend/static ./static

# Build arguments for environment variables.
# These are baked into the static build at image build-time.
ARG VITE_API_URL
ARG VITE_OWNER_NAME
ARG VITE_SITE_TITLE
ARG VITE_SITE_URL
ARG VITE_CONTACT_EMAIL
ARG VITE_GITHUB_URL
ARG VITE_LINKEDIN_URL
ARG VITE_TAGLINE
ARG VITE_AI_NAVIGATOR_DEFAULT_MODEL

ENV VITE_API_URL=${VITE_API_URL} \
    VITE_OWNER_NAME=${VITE_OWNER_NAME} \
    VITE_SITE_TITLE=${VITE_SITE_TITLE} \
    VITE_SITE_URL=${VITE_SITE_URL} \
    VITE_CONTACT_EMAIL=${VITE_CONTACT_EMAIL} \
    VITE_GITHUB_URL=${VITE_GITHUB_URL} \
    VITE_LINKEDIN_URL=${VITE_LINKEDIN_URL} \
    VITE_TAGLINE=${VITE_TAGLINE} \
    VITE_AI_NAVIGATOR_DEFAULT_MODEL=${VITE_AI_NAVIGATOR_DEFAULT_MODEL}

# Build the application (adapter-static outputs to build/)
#
# `tsconfig.json` extends `./.svelte-kit/tsconfig.json`, which is generated by
# `svelte-kit sync`. Running sync explicitly here avoids noisy warnings during
# `vite build` when `.svelte-kit` hasn't been generated yet.
RUN bunx --no-install svelte-kit sync
RUN bun run build

# Stage 2: Production server
FROM nginx:alpine AS runner

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy nginx config
COPY portfolio/frontend/nginx.conf /etc/nginx/nginx.conf

# Copy built assets from builder (SvelteKit adapter-static outputs to build/)
COPY --from=builder /app/build /usr/share/nginx/html

# Copy 200.html as index.html for the root path
RUN cp /usr/share/nginx/html/200.html /usr/share/nginx/html/index.html

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
