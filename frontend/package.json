{
	"name": "sveltefront",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.3.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run type-check",
		"check:watch": "bun run type-check:watch",
		"check:all": "bun run lint && bun run type-check && bun run test",
		"ci": "bun run lint && bun run type-check && bun run test:coverage",
		"lint": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" vite.config.ts --no-error-on-unmatched-pattern",
		"lint:strict": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" vite.config.ts --no-error-on-unmatched-pattern --max-warnings 0",
		"lint:fix": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" vite.config.ts --no-error-on-unmatched-pattern --fix",
		"lint:staged": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js --fix --no-error-on-unmatched-pattern",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"find-dead-code": "knip --cache --cache-location ../../.cache/knip-frontend",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.0.3",
		"@vitest/coverage-v8": "^4.0.13",
		"eslint": "^9.39.2",
		"eslint-plugin-perfectionist": "^5.2.0",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"jsdom": "^27.4.0",
		"knip": "^5.79.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^7.2.6",
		"vitest": "^4.0.13"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/source-sans-3": "^5.2.9",
		"@fontsource-variable/source-serif-4": "^5.2.9",
		"@tailwindcss/vite": "^4.1.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^0.561.0",
		"mermaid": "^11.12.2",
		"tailwind-merge": "^3.4.0"
	}
}
