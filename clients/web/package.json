{
	"name": "stageflow-web",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mattboback/stageflow.git",
		"directory": "clients/web"
	},
	"packageManager": "bun@1.3.8",
	"engines": {
		"node": "22.x"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run type-check",
		"check:watch": "bun run type-check:watch",
		"check:all": "bun run lint && bun run type-check && bun run test",
		"ci": "bun run format:check && bun run lint:strict && bun run type-check && bun run test:coverage",
		"lint": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" \".storybook/**/*.{ts,js,svelte}\" vite.config.ts vitest.config.ts svelte.config.js eslint.config.js --no-error-on-unmatched-pattern",
		"lint:strict": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" \".storybook/**/*.{ts,js,svelte}\" vite.config.ts vitest.config.ts svelte.config.js eslint.config.js --no-error-on-unmatched-pattern --max-warnings 0",
		"lint:fix": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,js,svelte}\" \"tests/**/*.{ts,js,svelte}\" \".storybook/**/*.{ts,js,svelte}\" vite.config.ts vitest.config.ts svelte.config.js eslint.config.js --no-error-on-unmatched-pattern --fix",
		"lint:staged": "bunx --no-install svelte-kit sync && node ./node_modules/eslint/bin/eslint.js --fix --no-error-on-unmatched-pattern",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"find-dead-code": "knip --cache --cache-location ../../.cache/knip-frontend",
		"storybook": "storybook dev -p 6006 --ci --no-open",
		"build-storybook": "storybook build",
		"check:asset-budget": "node ./scripts/check-asset-budget.mjs",
		"storybook:serve-static": "node ./scripts/serve-storybook-static.mjs",
		"test-storybook": "bun run build-storybook && bun run test-storybook:ci",
		"test-storybook:runner": "test-storybook --url ${STORYBOOK_URL:-http://127.0.0.1:6006} --browsers chromium --failOnConsole --skipTags skip-test",
		"test-storybook:ci": "node ./scripts/test-storybook-ci.mjs",
		"test-storybook:runner:ci": "test-storybook --url ${STORYBOOK_URL:-http://127.0.0.1:6006} --browsers chromium --failOnConsole --ci --junit --skipTags skip-test",
		"test-storybook:watch": "bun run build-storybook && start-server-and-test \"bun run storybook:serve-static\" http://127.0.0.1:6006 \"test-storybook --watch --url http://127.0.0.1:6006 --browsers chromium --skipTags skip-test\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "mkdir -p coverage/.tmp && vitest run --coverage --no-file-parallelism"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "8.6.17",
		"@storybook/addon-essentials": "8.6.17",
		"@storybook/svelte": "8.6.17",
		"@storybook/sveltekit": "8.6.17",
		"@storybook/test": "8.6.17",
		"@storybook/test-runner": "0.23.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "22",
		"@vitest/coverage-v8": "^4.0.13",
		"@vitest/eslint-plugin": "^1.6.17",
		"axe-playwright": "^2.2.2",
		"eslint": "^10.3.0",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^27.4.0",
		"knip": "^6.12.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"start-server-and-test": "^3.0.2",
		"storybook": "8.6.17",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^7.3.2",
		"vitest": "^4.0.13"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/source-sans-3": "^5.2.8",
		"@fontsource-variable/source-serif-4": "^5.2.8",
		"@tailwindcss/vite": "^4.1.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^0.561.0",
		"tailwind-merge": "^3.4.0"
	},
	"overrides": {
		"axios": "1.16.0",
		"devalue": "5.6.2",
		"follow-redirects": "1.16.0",
		"flatted": "3.4.2",
		"lodash": "4.18.1",
		"lodash-es": "4.18.1",
		"minimatch": "10.2.3",
		"picomatch": "^2.3.2",
		"rollup": "4.59.0",
		"vite": "7.3.2"
	},
	"resolutions": {
		"lodash": "4.18.1",
		"lodash-es": "4.18.1",
		"picomatch": "^2.3.2"
	}
}
