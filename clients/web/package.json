{
  "name": "web-react",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run build:offline && react-router dev",
    "build": "bun run build:offline && bun run build:app",
    "build:app": "react-router build",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "bun run build:offline && vitest run",
    "test:coverage": "bun run build:offline && vitest run --coverage",
    "test:e2e": "playwright test",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build:app",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.js\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\" \"*.js\"",
    "knip": "knip",
    "find-dead-code": "node ../../devtools/scripts/check-knip.mjs clients/web",
    "build:offline": "vite build --config vite.offline.config.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "isbot": "^5.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "6.44.2",
    "playwright-core": "1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.18",
    "undici": "8.12.2",
    "zod": "4.6.6"
  }
}
