# Multi-stage Dockerfile for SvelteKit Frontend
# Optimized for production with nginx

# Stage 1: Build
FROM docker.io/oven/bun:1.3.0-alpine AS builder
WORKDIR /app

# Copy package files first for better caching
COPY clients/web/package.json clients/web/bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy SvelteKit source code
COPY clients/web/svelte.config.js clients/web/vite.config.ts clients/web/tsconfig.json ./
COPY clients/web/src ./src
COPY clients/web/static ./static

# Build arguments for environment variables.
# These are baked into the static build at image build-time.
ARG VITE_API_URL
ARG VITE_SITE_TITLE
ARG VITE_SITE_URL
ARG VITE_GITHUB_URL
ARG VITE_TAGLINE
ARG VITE_AI_NAVIGATOR_DEFAULT_MODEL

ENV VITE_API_URL=${VITE_API_URL} \
    VITE_SITE_TITLE=${VITE_SITE_TITLE} \
    VITE_SITE_URL=${VITE_SITE_URL} \
    VITE_GITHUB_URL=${VITE_GITHUB_URL} \
    VITE_TAGLINE=${VITE_TAGLINE} \
    VITE_AI_NAVIGATOR_DEFAULT_MODEL=${VITE_AI_NAVIGATOR_DEFAULT_MODEL}

# Build the application (adapter-static outputs to build/)
#
# `tsconfig.json` extends `./.svelte-kit/tsconfig.json`, which is generated by
# `svelte-kit sync`. Running sync explicitly here avoids noisy warnings during
# `vite build` when `.svelte-kit` hasn't been generated yet.
RUN bunx --no-install svelte-kit sync
RUN bun run build

# Stage 2: Production server
FROM docker.io/library/nginx:alpine AS runner

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Install nginx config inline so the image does not depend on repo-local
# serving config churn, while still preserving prerendered route output.
RUN cat <<'EOF' >/etc/nginx/nginx.conf
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;

    server {
        listen 3000;
        listen [::]:3000;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        client_max_body_size 100M;

        location /api/ {
            proxy_pass http://platform-api:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            proxy_connect_timeout 600s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }

        location ~* ^/_app/.*\.(js|css|woff2|woff|ttf|eot)$ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location ~* \.(js|css|woff2|woff|ttf|eot)$ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location ~* \.(jpg|jpeg|png|gif|ico|svg|webp)$ {
            add_header Cache-Control "public, max-age=31536000" always;
            try_files $uri =404;
        }

        location / {
            add_header Cache-Control "public, max-age=0, must-revalidate" always;
            try_files $uri $uri/ $uri.html /200.html;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }
    }
}
EOF

# Copy built assets from builder (SvelteKit adapter-static outputs to build/)
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
