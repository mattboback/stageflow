# Multi-stage Dockerfile for SvelteKit Frontend
# Optimized for production with nginx

# Stage 1: Build
FROM docker.io/oven/bun:1.3.8-alpine AS builder
WORKDIR /app

# Copy package files first for better caching
COPY clients/web/package.json clients/web/bun.lock ./

# Install dependencies without lifecycle scripts. `prepare` runs `svelte-kit sync`,
# but the config file is copied in a later layer for better cache reuse.
RUN bun install --frozen-lockfile --ignore-scripts

# Copy SvelteKit source code
COPY clients/web/svelte.config.js clients/web/vite.config.ts clients/web/tsconfig.json ./
COPY clients/web/src ./src
COPY clients/web/static ./static

# Build arguments for environment variables.
# These are baked into the static build at image build-time.
ARG VITE_API_URL
ARG VITE_SITE_TITLE
ARG VITE_SITE_URL
ARG VITE_GITHUB_URL
ARG VITE_TAGLINE
ARG VITE_AI_NAVIGATOR_DEFAULT_MODEL

ENV VITE_API_URL=${VITE_API_URL} \
    VITE_SITE_TITLE=${VITE_SITE_TITLE} \
    VITE_SITE_URL=${VITE_SITE_URL} \
    VITE_GITHUB_URL=${VITE_GITHUB_URL} \
    VITE_TAGLINE=${VITE_TAGLINE} \
    VITE_AI_NAVIGATOR_DEFAULT_MODEL=${VITE_AI_NAVIGATOR_DEFAULT_MODEL}

# Build the application (adapter-static outputs to build/)
#
# `tsconfig.json` extends `./.svelte-kit/tsconfig.json`, which is generated by
# `svelte-kit sync`. Running sync explicitly here avoids noisy warnings during
# `vite build` when `.svelte-kit` hasn't been generated yet.
RUN bunx --no-install svelte-kit sync
RUN bun run build

# Stage 2: Production server
FROM docker.io/library/nginx:1.29-alpine AS runner

# Remove default nginx content and config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy the repo-owned nginx config so Docker and Podman follow the same path.
COPY clients/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder (SvelteKit adapter-static outputs to build/)
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
