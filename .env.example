# Copy to `.env` for local dev.
# These defaults are local-first; override them before self-hosting on a real domain.
# Keep real secrets (passwords/API keys) out of git.

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=stageflow
MINIO_SECRET_KEY=change-me

# Postgres
POSTGRES_USER=stageflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stageflow
DATABASE_URL=postgres://stageflow:change-me@postgres:5432/stageflow?sslmode=disable

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=http://localhost:3001

# AI (optional)
OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=StageFlow
OPENROUTER_APP_REFERER=http://localhost:3000
AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Caddy (production/quadlets)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Public config (used by Caddy/CORS/presigned URLs)
STAGEFLOW_PUBLIC_DOMAIN=localhost
PLATFORM_API_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://localhost:8080

# Frontend
VITE_API_URL=http://localhost:8080
VITE_SITE_TITLE=StageFlow
VITE_SITE_URL=http://localhost:3000
VITE_GITHUB_URL=https://github.com/mattboback/stageflow
VITE_TAGLINE="Podman-native web accessibility and quality scanning platform"
VITE_AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# ==============================================================================
# Deployment Guardrails (Optional)
# ==============================================================================
# STAGEFLOW_PROTECTED_HOST=your.vps.hostname.com
# STAGEFLOW_ALLOW_VPS_LOCAL_STACKS=0
# STAGEFLOW_PROD_DEPLOY_DIR=/path/to/your/deployment/control/plane
