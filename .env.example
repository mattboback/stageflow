# StageFlow Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to git

# MinIO Object Storage
# Root creds are used only for admin/setup; app creds are used by services.
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-secure-32-char-password
MINIO_ACCESS_KEY=stageflow-app
MINIO_SECRET_KEY=your-secure-32-char-password

# Grafana Monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
# Must include the /monitoring/ subpath (served behind Caddy).
GF_SERVER_ROOT_URL=https://stageflow.org/monitoring/
# Optional: allow read-only dashboards without a Grafana login (recommended only when /monitoring is protected by Caddy Basic Auth).
# GF_AUTH_ANONYMOUS_ENABLED=true
# GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# AI Providers (optional - required for ai-navigator scanner)
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional (recommended): metadata sent to OpenRouter for usage tracking
OPENROUTER_APP_TITLE=StageFlow
OPENROUTER_APP_REFERER=https://stageflow.org
# Optional default OpenRouter model for ai-navigator (can still be overridden per job).
AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Caddy Web Server Ports (optional - defaults shown)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Public domain used for presigned URLs, Grafana root URL, and default CORS/SPA config.
STAGEFLOW_PUBLIC_DOMAIN=stageflow.org

# Frontend Configuration
VITE_API_URL=https://stageflow.org
VITE_SITE_TITLE=StageFlow
VITE_SITE_URL=https://stageflow.org
VITE_GITHUB_URL=https://github.com/mattboback/stageflow
VITE_TAGLINE="Podman-native web accessibility scanning platform"
# Optional frontend default (pre-fills the AI Navigator model field)
VITE_AI_NAVIGATOR_DEFAULT_MODEL=openai/gpt-4o-mini

# Optional CORS override:
# CORS_ALLOW_ORIGINS=https://stageflow.org,https://www.stageflow.org
