# Copy to `.env` for local dev.
# These defaults are local-first; override them before self-hosting on a real domain.
# Keep real secrets (passwords/API keys) out of git.

# Compose host ports bind to 127.0.0.1. For a second stack, also choose a unique
# COMPOSE_PROJECT_NAME and STAGEFLOW_NETWORK_NAME (for example audit/audit_net).
# Keep the browser URLs and CORS below consistent with any changed ports.
FRONTEND_PORT=3000
PLATFORM_API_PORT=8080
ORCHESTRATOR_PORT=8081
NATS_PORT=4222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IMAGE_TAG=latest

# Job pods use the stack network by default. For localhost scans, set host mode
# and explicitly add POD_NETWORK= (empty). Host mode requires NATS_PORT=4222 and
# MINIO_PORT=9000; job containers use those fixed loopback endpoints.
POD_NETNS_MODE=bridge
PLATFORM_API_ALLOW_PRIVATE_TARGETS=false

# MinIO
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
MINIO_USE_PROXY_URLS=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=stageflow
MINIO_SECRET_KEY=change-me
MINIO_STAGING_RETENTION_DAYS=1
MINIO_ARTIFACT_RETENTION_DAYS=1

# Postgres
POSTGRES_USER=stageflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stageflow
DATABASE_URL=postgres://stageflow:change-me@postgres:5432/stageflow?sslmode=disable

# Public config (used by CORS/presigned URLs)
STAGEFLOW_PUBLIC_DOMAIN=localhost
PLATFORM_API_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:3020,http://127.0.0.1:3020
ORCHESTRATOR_API_TOKEN=change-me-orchestrator-token
# Optional. Public API routes do not require a token. A caller sending this
# token (X-Api-Key or Authorization: Bearer) skips rate limits and may request
# allow_private_targets when PLATFORM_API_ALLOW_PRIVATE_TARGETS=true.
# Give it only to trusted server callers.
PLATFORM_API_TOKEN=change-me-platform-api-token
# Shared token bucket for URL, ZIP and discovery submissions from callers
# without the token.
PLATFORM_API_PUBLIC_SUBMISSION_RATE_LIMIT_RPM=6
PLATFORM_API_PUBLIC_SUBMISSION_RATE_LIMIT_BURST=3
# Comma-separated CIDRs whose X-Forwarded-For header is trusted for
# rate-limit keying. Loopback suits a reverse proxy on the same host; replace
# this with your reverse proxy's exact source range when it differs.
PLATFORM_API_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Orchestrator -> Podman control plane
# Creating a job pod writes the pod record, creates the infra container, and
# programs the network namespace, which on a loaded host runs past a short
# timeout. A create whose response is lost leaves a pod behind, so these are the
# knobs to raise if you see adoption happening often in the logs.
# PODMAN_RESPONSE_HEADER_TIMEOUT must be <= PODMAN_REQUEST_TIMEOUT, which caps the
# whole exchange; otherwise it can never be reached.
PODMAN_REQUEST_TIMEOUT=120s
PODMAN_RESPONSE_HEADER_TIMEOUT=60s
PODMAN_DIAL_TIMEOUT=5s

# Frontend
VITE_API_URL=http://localhost:8080
VITE_SITE_TITLE="StageFlow — Frontend quality regression scanning"
VITE_SITE_URL=http://localhost:3000
VITE_GITHUB_URL=https://github.com/mattboback/stageflow
VITE_TAGLINE="Self-hostable frontend quality regression scanning"
# Use `hosted-demo` only for a public demo; self-hosted is the safe default.
VITE_DEPLOYMENT_MODE=self-hosted

# ==============================================================================
# Deployment Guardrails (Optional)
# Use these on shared hosts to block repo-local dev commands on the live machine.
# ==============================================================================
# STAGEFLOW_PROTECTED_HOST=your.production.hostname.example
# STAGEFLOW_ALLOW_VPS_LOCAL_STACKS=0
# STAGEFLOW_PROD_DEPLOY_DIR=/path/to/external/deployment/control-plane
