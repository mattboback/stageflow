{
	"name": "@stageflow/contracts-provenance",
	"version": "1.0.0",
	"packageManager": "bun@1.3.8",
	"engines": {
		"node": "24.x"
	},
	"description": "Provenance schema and types for StageFlow (the scanner-runner intake document, including the optional auth block)",
	"private": true,
	"main": "dist/generated/typescript/index.js",
	"types": "dist/generated/typescript/index.d.ts",
	"scripts": {
		"generate": "../../../devtools/scripts/generate-contracts.sh",
		"generate:ts": "../../../devtools/scripts/generate-contracts.sh ts",
		"generate:go": "../../../devtools/scripts/generate-contracts.sh go",
		"validate": "node schema/validate.js",
		"validate:fixtures": "node schema/validate.js fixtures/provenance.no-auth.json && node schema/validate.js fixtures/provenance.auth-storage-state.json && node schema/validate.js fixtures/provenance.auth-form.json && node schema/validate.js fixtures/provenance.auth-form-literal.json",
		"build": "bun run generate && bun run validate:fixtures && tsc",
		"typecheck": "tsc --noEmit",
		"check": "./scripts/pre-commit-check.sh"
	},
	"exports": {
		".": {
			"types": "./dist/generated/typescript/index.d.ts",
			"import": "./dist/generated/typescript/index.js",
			"require": "./dist/generated/typescript/index.js"
		},
		"./schema": {
			"import": "./schema/provenance.schema.json",
			"require": "./schema/provenance.schema.json"
		},
		"./validator-cli": {
			"import": "./schema/validate.js",
			"require": "./schema/validate.js"
		}
	},
	"files": [
		"dist/**/*",
		"schema/*.json",
		"schema/validate.js",
		"fixtures/*.json"
	],
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"json-schema-to-typescript": "^15.0.4",
		"typescript": "^7.0.2"
	}
}
