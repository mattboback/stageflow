{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://stageflow.dev/schemas/provenance.json",
	"title": "Provenance",
	"description": "Wire format for the Provenance document that flows from CLI/orchestrator into the scanner-runner. The auth field is optional. When auth is absent the document is byte-identical to the pre-auth Provenance.",
	"type": "object",
	"required": [
		"version",
		"job_id",
		"base_url",
		"pages"
	],
	"additionalProperties": false,
	"properties": {
		"version": {
			"type": "string",
			"minLength": 1
		},
		"job_id": {
			"type": "string",
			"minLength": 1
		},
		"base_url": {
			"type": "string"
		},
		"mode": {
			"$ref": "#/definitions/ProvenanceMode"
		},
		"default_wait_for": {
			"$ref": "#/definitions/WaitStrategy"
		},
		"default_viewport": {
			"$ref": "#/definitions/Viewport"
		},
		"pages": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/PageEntry"
			}
		},
		"auth": {
			"$ref": "#/definitions/ProvenanceAuth"
		},
		"metadata": {
			"type": "object",
			"additionalProperties": true
		}
	},
	"definitions": {
		"ProvenanceMode": {
			"title": "ProvenanceMode",
			"type": "string",
			"enum": [
				"static",
				"spa",
				"live"
			]
		},
		"Viewport": {
			"title": "Viewport",
			"type": "object",
			"required": [
				"width",
				"height"
			],
			"additionalProperties": false,
			"properties": {
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"WaitStrategy": {
			"title": "WaitStrategy",
			"oneOf": [
				{
					"type": "object",
					"required": [
						"type"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"load"
							]
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"domcontentloaded"
							]
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"networkidle"
							]
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"selector"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"selector"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"timeout": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"ms"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"timeout"
							]
						},
						"ms": {
							"type": "integer",
							"minimum": 0
						}
					}
				}
			]
		},
		"PreScanActionValue": {
			"title": "PreScanActionValue",
			"description": "Either a literal string or a typed {from_env: NAME} reference resolved at execution time. Persisted Provenance only ever contains the literal string or the {from_env} reference, never the resolved value.",
			"oneOf": [
				{
					"type": "string"
				},
				{
					"type": "object",
					"required": [
						"from_env"
					],
					"additionalProperties": false,
					"properties": {
						"from_env": {
							"type": "string",
							"pattern": "^[A-Z][A-Z0-9_]*$",
							"minLength": 1
						}
					}
				}
			]
		},
		"PreScanAction": {
			"title": "PreScanAction",
			"oneOf": [
				{
					"type": "object",
					"required": [
						"type",
						"selector"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"click"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"timeout": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"selector",
						"value"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"fill"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"value": {
							"$ref": "#/definitions/PreScanActionValue"
						},
						"timeout": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"selector",
						"value"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"select"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"value": {
							"$ref": "#/definitions/PreScanActionValue"
						},
						"timeout": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"selector"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"hover"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"timeout": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"ms"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"wait"
							]
						},
						"ms": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"scroll"
							]
						},
						"selector": {
							"type": "string",
							"minLength": 1
						},
						"direction": {
							"type": "string",
							"enum": [
								"up",
								"down"
							]
						},
						"pixels": {
							"type": "integer"
						}
					}
				},
				{
					"type": "object",
					"required": [
						"type",
						"key"
					],
					"additionalProperties": false,
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"keyboard"
							]
						},
						"key": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			]
		},
		"PageEntry": {
			"title": "PageEntry",
			"type": "object",
			"required": [
				"id"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"path": {
					"type": "string"
				},
				"url": {
					"type": "string"
				},
				"wait_for": {
					"$ref": "#/definitions/WaitStrategy"
				},
				"pre_scan_actions": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/PreScanAction"
					}
				},
				"viewport": {
					"$ref": "#/definitions/Viewport"
				},
				"skip": {
					"type": "boolean"
				},
				"metadata": {
					"type": "object",
					"additionalProperties": true
				}
			}
		},
		"ProvenanceAuth": {
			"title": "ProvenanceAuth",
			"description": "Optional authentication block. Discriminated by mode. Secrets are never persisted: form recipes only ever carry literal strings or {from_env} references, and storage_state holds an artifact key, not the credentials that produced it.",
			"oneOf": [
				{
					"$ref": "#/definitions/ProvenanceAuthStorageState"
				},
				{
					"$ref": "#/definitions/ProvenanceAuthForm"
				}
			]
		},
		"ProvenanceAuthStorageState": {
			"title": "ProvenanceAuthStorageState",
			"type": "object",
			"required": [
				"mode",
				"artifact_key"
			],
			"additionalProperties": false,
			"properties": {
				"mode": {
					"type": "string",
					"enum": [
						"storage_state"
					]
				},
				"artifact_key": {
					"type": "string",
					"minLength": 1,
					"description": "Object key relative to the job's MinIO bucket. Resolved via StorageProvider at hydration time."
				}
			}
		},
		"ProvenanceAuthForm": {
			"title": "ProvenanceAuthForm",
			"type": "object",
			"required": [
				"mode",
				"login_url",
				"steps",
				"success"
			],
			"additionalProperties": false,
			"properties": {
				"mode": {
					"type": "string",
					"enum": [
						"form"
					]
				},
				"login_url": {
					"type": "string",
					"minLength": 1,
					"description": "URL the scanner-runner navigates to before replaying steps. Subject to the same SSRF policy as every other navigation."
				},
				"steps": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/definitions/PreScanAction"
					},
					"description": "Login replay. Reuses the existing PreScanAction shape so any value field can be a literal string or a {from_env} reference."
				},
				"success": {
					"$ref": "#/definitions/WaitStrategy",
					"description": "Wait strategy that signals a successful login. The post-login URL captured at this point is recorded in the auth_hydrated event and in any AuthHydrationError."
				}
			}
		}
	}
}
