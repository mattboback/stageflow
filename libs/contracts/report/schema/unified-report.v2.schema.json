{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stageflow.dev/schemas/unified-report.v2.json",
  "title": "UnifiedReportV2",
  "description": "Unified accessibility and quality scan report schema aggregating results from multiple scanners",
  "type": "object",
  "required": ["version", "meta", "summary", "scanners", "pages", "issues"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Schema version (semver format, major version 2)"
    },
    "meta": { "$ref": "#/definitions/ReportMeta" },
    "summary": { "$ref": "#/definitions/ReportSummary" },
    "scanners": {
      "type": "array",
      "items": { "$ref": "#/definitions/ScannerSummary" }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/definitions/PageSummary" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/definitions/IssueDetail" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/ReportArtifact" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/ReportError" }
    }
  },
  "definitions": {
    "ReportMeta": {
      "type": "object",
      "required": ["jobId"],
      "additionalProperties": false,
      "properties": {
        "jobId": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "scannedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "ReportSummary": {
      "type": "object",
      "required": ["totalIssues", "bySeverity", "pagesScanned", "pagesWithIssues"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scoreGrade": { "type": "string", "pattern": "^[A-F][+-]?$" },
        "totalIssues": { "type": "integer", "minimum": 0 },
        "bySeverity": { "$ref": "#/definitions/SeverityCounts" },
        "byScanner": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "pagesScanned": { "type": "integer", "minimum": 0 },
        "pagesWithIssues": { "type": "integer", "minimum": 0 },
        "lighthouseCategories": {
          "type": "array",
          "items": { "$ref": "#/definitions/LighthouseCategorySummary" }
        }
      }
    },
    "SeverityCounts": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "minor"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "serious": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "LighthouseCategorySummary": {
      "type": "object",
      "required": ["id", "title", "avgScore"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": ["performance", "accessibility", "best-practices", "seo", "pwa"]
        },
        "title": { "type": "string", "minLength": 1 },
        "avgScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ScannerSummary": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "status": { "$ref": "#/definitions/ScannerStatus" },
        "error": { "type": "string" },
        "issueCount": { "type": "integer", "minimum": 0 },
        "severity": { "$ref": "#/definitions/SeverityCounts" },
        "toolVersion": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "resultsPath": { "type": "string" },
        "reportPath": { "type": "string" }
      }
    },
    "ScannerStatus": {
      "type": "string",
      "enum": ["success", "failed", "skipped"]
    },
    "PageSummary": {
      "type": "object",
      "required": ["id", "url", "issueCount", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "path": { "type": "string" },
        "issueCount": { "type": "integer", "minimum": 0 },
        "bySeverity": { "$ref": "#/definitions/SeverityCounts" },
        "durationMs": { "type": "number", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "pageOverview": { "$ref": "#/definitions/PageOverview" }
      }
    },
    "PageOverview": {
      "type": "object",
      "required": ["screenshotFilename", "pageWidth", "pageHeight", "elements"],
      "additionalProperties": false,
      "properties": {
        "screenshotFilename": { "type": "string", "minLength": 1 },
        "pageWidth": { "type": "number", "minimum": 0 },
        "pageHeight": { "type": "number", "minimum": 0 },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/definitions/PageOverviewElement" }
        }
      }
    },
    "PageOverviewElement": {
      "type": "object",
      "required": ["issueId", "ruleId", "severity", "selector", "nodeIndex", "xPercent", "yPercent", "widthPercent", "heightPercent", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "issueId": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/definitions/IssueSeverity" },
        "selector": { "type": "string" },
        "nodeIndex": { "type": "integer", "minimum": 0 },
        "xPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "yPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "widthPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "heightPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "IssueDetail": {
      "type": "object",
      "required": ["id", "scanner", "ruleId", "severity", "title", "description", "pageId", "pageUrl", "elementCount"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scanner": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/definitions/IssueSeverity" },
        "severityRaw": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "helpUrl": { "type": "string", "format": "uri" },
        "wcagTags": { "type": "array", "items": { "type": "string" } },
        "pageId": { "type": "string", "minLength": 1 },
        "pageUrl": { "type": "string", "format": "uri" },
        "elementCount": { "type": "integer", "minimum": 0 },
        "elementsTruncated": { "type": "boolean" },
        "occurrences": {
          "type": "array",
          "items": { "$ref": "#/definitions/IssueOccurrence" }
        },
        "category": { "type": "string" },
        "friendlyNode": { "$ref": "#/definitions/FriendlyNodeInfo" },
        "locationInfo": { "$ref": "#/definitions/LocationInfo" },
        "userImpact": { "$ref": "#/definitions/UserImpact" },
        "howToFix": { "type": "string" },
        "scannerData": { "type": "object", "additionalProperties": true }
      }
    },
    "IssueOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "type": "array", "items": { "type": "string" } },
        "selector": { "type": "string" },
        "html": { "type": "string" },
        "contextHtml": {
          "type": "string",
          "description": "HTML snippet with ancestor chain and siblings for debugging context (bounded size)"
        },
        "ancestorPath": {
          "type": "string",
          "description": "Breadcrumb path of ancestor elements (e.g., 'html > body > main > div.container')"
        },
        "failureSummary": { "type": "string" },
        "textSnippet": { "type": "string" },
        "boundingBox": { "$ref": "#/definitions/BoundingBox" },
        "elementId": { "type": "string" },
        "pageId": { "type": "string" },
        "label": { "type": "string" },
        "artifactIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BoundingBox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "FriendlyNodeInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "tagName": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "textSnippet": { "type": "string" },
        "selector": { "type": "string" }
      }
    },
    "LocationInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrollY": { "type": "number", "minimum": 0 },
        "viewportHeight": { "type": "number", "minimum": 0 },
        "docHeight": { "type": "number", "minimum": 0 },
        "position": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "UserImpact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string" },
        "affectedGroups": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserGroup" }
        },
        "severity": { "$ref": "#/definitions/UserImpactSeverity" },
        "userStory": { "type": "string" }
      }
    },
    "UserGroup": {
      "type": "string",
      "enum": ["blind", "low-vision", "motor", "cognitive", "deaf", "vestibular", "all"]
    },
    "UserImpactSeverity": {
      "type": "string",
      "enum": ["blocking", "degraded", "inconvenient"]
    },
    "IssueSeverity": {
      "type": "string",
      "enum": ["critical", "serious", "moderate", "minor", "info"]
    },
    "ReportArtifact": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "mime": { "type": "string" },
        "dataUri": { "type": "string" }
      }
    },
    "ReportError": {
      "type": "object",
      "required": ["scope", "code", "message", "retryable"],
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/definitions/ErrorScope" },
        "scannerId": { "type": "string" },
        "pageId": { "type": "string" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "ErrorScope": {
      "type": "string",
      "enum": ["scanner", "page", "global"]
    }
  }
}
