{
	"name": "@stageflow/contracts-report",
	"version": "2.0.0",
	"private": true,
	"packageManager": "bun@1.3.8",
	"engines": {
		"node": "24.x"
	},
	"description": "Unified Report schema and types for StageFlow",
	"main": "dist/generated/typescript/index.js",
	"types": "dist/generated/typescript/index.d.ts",
	"scripts": {
		"generate": "../../../devtools/scripts/generate-contracts.sh",
		"generate:ts": "../../../devtools/scripts/generate-contracts.sh ts",
		"generate:go": "../../../devtools/scripts/generate-contracts.sh go",
		"validate": "node schema/validate.js",
		"validate:fixtures": "node schema/validate.js fixtures/unified-report.v2.json && node schema/validate.js fixtures/unified-report.v2.all-scans.json",
		"build": "bun run generate && bun run validate:fixtures && tsc",
		"typecheck": "tsc --noEmit"
	},
	"exports": {
		".": {
			"types": "./dist/generated/typescript/index.d.ts",
			"import": "./dist/generated/typescript/index.js",
			"require": "./dist/generated/typescript/index.js"
		},
		"./schema": {
			"import": "./schema/unified-report.v2.schema.json",
			"require": "./schema/unified-report.v2.schema.json"
		},
		"./validator-cli": {
			"import": "./schema/validate.js",
			"require": "./schema/validate.js"
		}
	},
	"files": [
		"dist/**/*",
		"schema/*.json",
		"schema/validate.js"
	],
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"json-schema-to-typescript": "^16.0.0",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"picomatch": "4.0.4"
	}
}
